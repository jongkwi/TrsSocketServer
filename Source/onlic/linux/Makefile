# onlic default Makefile - delegates to Makefile_64bit (onmw style). `make` == `make -f Makefile_64bit`
all:
	$(MAKE) -f Makefile_64bit all
onlic:
	$(MAKE) -f Makefile_64bit onlic
clean:
	$(MAKE) -f Makefile_64bit clean
distclean:
	$(MAKE) -f Makefile_64bit distclean
.PHONY: all onlic clean distclean
